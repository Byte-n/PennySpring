# PennySpring agent 联调凭据（示例文件，可提交）
#
# 用法：
#   cp .env.agent.example .env.agent.local
#   在 .env.agent.local 里填写下面三项，然后运行：
#   node scripts/agent-probe.mjs
#
# 注意：
#   1. .env.agent.local 已被 .gitignore 忽略，不会进入版本库；
#   2. 这些变量只供本地探针脚本使用，不会进入 App 产物；
#   3. App 运行时的端点与 Key 由用户在设置页填写，Key 存 Keychain/Keystore；
#   4. 不要把真实 Key 粘贴到聊天、issue、截图或任何会留下记录的地方。

# OpenAI-compatible Base URL，形如 https://api.deepseek.com/v1
# 不要包含 /chat/completions
AGENT_BASE_URL=

# 该端点的 API Key
AGENT_API_KEY=

# 模型 ID，如 deepseek-chat / gpt-4o-mini / qwen-plus / llama3.1
AGENT_MODEL=
