                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/quick_template_widget_book_none"
                android:textColor="@color/quick_template_widget_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

