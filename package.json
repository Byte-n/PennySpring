{
  "name": "pennyspring",
  "version": "0.0.6",
  "private": true,
  "description": "本地优先的 React Native 记账应用：多账本、AI 助手、备份迁移与主题化组件库。",
  "license": "MIT",
  "author": "Byte-n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byte-n/PennySpring.git"
  },
  "homepage": "https://github.com/Byte-n/PennySpring#readme",
  "bugs": {
    "url": "https://github.com/Byte-n/PennySpring/issues"
  },
  "keywords": [
    "react-native",
    "personal-finance",
    "accounting",
    "sqlite",
    "drizzle-orm",
    "ai-agent"
  ],
  "workspaces": [
    "packages/*",
    "packages/pennyspring-ui/examples"
  ],
  "scripts": {
    "android": "react-native run-android --active-arch-only --port 8080 --appIdSuffix debug",
    "release:android": "node scripts/release-android.js",
    "ios": "react-native run-ios --port 8080",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "react-native start --port 8080",
    "test": "jest --watchman=false",
    "format": "yarn format:prettier && yarn format:swift && yarn format:kotlin",
    "format:prettier": "prettier --write .",
    "format:check": "yarn format:check:prettier && yarn format:check:swift && yarn format:check:kotlin",
    "format:check:prettier": "prettier --check .",
    "format:swift": "xcrun swift-format format --in-place --recursive ios/PennySpring packages/pennyspring-ui/examples/ios/PennySpringUIExamples",
    "format:check:swift": "xcrun swift-format lint --strict --recursive ios/PennySpring packages/pennyspring-ui/examples/ios/PennySpringUIExamples",
    "format:kotlin": "yarn format:kotlin:app && yarn format:kotlin:examples",
    "format:kotlin:app": "cd android && ./gradlew app:ktlintFormat",
    "format:kotlin:examples": "cd packages/pennyspring-ui/examples/android && ./gradlew app:ktlintFormat",
    "format:check:kotlin": "yarn format:check:kotlin:app && yarn format:check:kotlin:examples",
    "format:check:kotlin:app": "cd android && ./gradlew app:ktlintCheck",
    "format:check:kotlin:examples": "cd packages/pennyspring-ui/examples/android && ./gradlew app:ktlintCheck",
    "generate:brand": "node scripts/generate-brand-assets.js",
    "adb:wireless": "node scripts/adb-wireless.js",
    "adb:tui": "node packages/adb-tui/bin/adb-tui.cjs",
    "init:codex": "node scripts/init-codex.js",
    "clean": "bash scripts/clean.sh",
    "ws": "node scripts/workspace-runner.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.80",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@assistant-ui/ai-sdk": "0.0.16",
    "@assistant-ui/react-native": "0.1.51",
    "@op-engineering/op-sqlite": "^15.2.14",
    "@pennyspring/api": "*",
    "@pennyspring/data": "*",
    "@pennyspring/share": "*",
    "@pennyspring/theme": "*",
    "@pennyspring/ui": "*",
    "@react-native-documents/picker": "^10.1.7",
    "@react-navigation/material-top-tabs": "^7.4.24",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@shopify/react-native-skia": "^2.6.4",
    "@wuba/react-native-echarts": "^3.0.1",
    "ahooks": "^3.9.7",
    "ai": "7.0.155",
    "base64-js": "^1.5.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.46.1",
    "fflate": "^0.8.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-bootsplash": "^7.3.2",
    "react-native-file-access": "^4.0.4",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pager-view": "^8.0.1",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-native-sherpa-onnx": "0.4.4",
    "react-native-svg": "^15.15.4",
    "react-native-tab-view": "^4.3.0",
    "react-native-worklets": "^0.8.1",
    "text-encoding-utf-8": "1.0.2",
    "tslib": "2.3.0",
    "web-streams-polyfill": "^4.3.0",
    "zod": "^4.1.8",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-live-codeblock": "^3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "@pennyspring/data-server": "*",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-native-web": "^0.21.2",
    "eslint": "^8.19.0",
    "inquirer": "^8.2.7",
    "inquirer-search-list": "^1.2.6",
    "jest": "^29.6.3",
    "ora": "^5.4.1",
    "patch-package": "^8.0.1",
    "prettier": "3.9.10",
    "react-dom": "19.2.3",
    "react-live": "^4.1.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
