{
  "name": "@pennyspring/data-server-wrapper",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "bin": {
    "data-server-wrapper": "dist/bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=es2022 --sourcemap --outfile=dist/bin.js --external:hono --external:@hono/node-server --external:better-sqlite3 --external:drizzle-orm --external:drizzle-orm/*",
    "start": "export DB_PATH=\"server.db\" && node dist/bin.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@pennyspring/data": "*",
    "@pennyspring/data-server": "*",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
