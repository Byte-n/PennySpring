{
  "name": "@pennyspring/data",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle/migrations": "./drizzle/migrations.js",
