{
  "name": "@pennyspring/data",
  "version": "0.0.1",
  "private": true,
  "description": "PennySpring 驱动无关数据层：Drizzle schema、迁移、业务服务与 Api 工厂。",
  "license": "MIT",
  "author": "Byte-n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byte-n/PennySpring.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/Byte-n/PennySpring/tree/main/packages/data#readme",
  "bugs": {
    "url": "https://github.com/Byte-n/PennySpring/issues"
  },
  "keywords": [
    "drizzle-orm",
    "sqlite",
    "schema",
    "accounting"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle/migrations": "./drizzle/migrations.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ../../jest.config.js --watchman=false packages/data"
  },
  "dependencies": {
    "@pennyspring/share": "*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
