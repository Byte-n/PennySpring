          "shadowRadius": 12,
        },
        undefined,
        {
          "opacity": 1,
          "transform": [
            {
              "translateY": 0,
            },
          ],
        },
      ]
    }
    testID="popup-body"
  >
    <Text>
      Content
    </Text>
  </View>
</View>
`;

