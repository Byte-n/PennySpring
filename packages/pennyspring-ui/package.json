{
  "name": "@pennyspring/ui",
  "version": "0.0.1",
  "private": true,
  "description": "PennySpring 的 React Native 组件库：60+ 组件、主题集成、预览与文档。",
  "license": "MIT",
  "author": "Byte-n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byte-n/PennySpring.git",
    "directory": "packages/pennyspring-ui"
  },
  "homepage": "https://github.com/Byte-n/PennySpring/tree/main/packages/pennyspring-ui#readme",
  "bugs": {
    "url": "https://github.com/Byte-n/PennySpring/issues"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "design-system"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "previews:sync": "node scripts/sync-previews.cjs",
    "previews:check": "node scripts/sync-previews.cjs --check",
    "docs:dev": "node scripts/sync-previews.cjs && docusaurus start",
    "docs:build": "node scripts/sync-previews.cjs && docusaurus build --out-dir docs-dist",
    "docs:preview": "docusaurus serve docs-dist",
    "docs:sync": "node scripts/sync-previews.cjs",
    "docs:check": "node scripts/sync-previews.cjs --check",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ../../jest.config.js --watchman=false packages/pennyspring-ui"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "dependencies": {
    "@pennyspring/theme": "*",
    "@react-native-documents/picker": "^10.1.7",
    "@tanstack/react-form": "1.33.5",
    "phosphor-react-native": "*",
    "react-device-frameset": "^1.3.4",
    "react-native-image-picker": "^8.2.1"
  }
}
