{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@pennyspring/theme": ["./packages/pennyspring-theme/src"],
      "@pennyspring/theme/*": ["./packages/pennyspring-theme/*"],
      "@pennyspring/ui": ["./packages/pennyspring-ui/src"],
      "@pennyspring/ui/*": ["./packages/pennyspring-ui/*"],
      "@pennyspring/ui/examples": ["./packages/pennyspring-ui/examples"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods", "packages/adb-tui"]
}
